{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": { "taskplan-frontend": { "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "tp", "architect": {
    "build": { "builder": "@angular/build:application", "options": { "browser": "src/main.ts", "tsConfig": "tsconfig.app.json", "assets": [{ "glob": "**/*", "input": "public" }], "styles": ["src/styles.css"] }, "configurations": { "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" }] } } },
    "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "taskplan-frontend:build:production" }, "development": { "buildTarget": "taskplan-frontend:build" } }, "defaultConfiguration": "development" },
    "test": { "builder": "@angular/build:karma", "options": { "tsConfig": "tsconfig.spec.json", "assets": [{ "glob": "**/*", "input": "public" }], "styles": ["src/styles.css"] } },
    "lint": { "builder": "@angular/build:application", "options": { "browser": "src/main.ts", "tsConfig": "tsconfig.app.json", "assets": [{ "glob": "**/*", "input": "public" }], "styles": ["src/styles.css"] } }
  } } }
}
