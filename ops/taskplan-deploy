#!/usr/bin/env bash
set -Eeuo pipefail

app=taskplan
repo=/opt/taskplan/src/taskplan
compose=/etc/taskplan/compose.yaml
env_file=/etc/taskplan/taskplan.env
state_dir=/var/lib/taskplan
release_env="$state_dir/release.env"
state_file="$state_dir/current-release"
log_file=/var/log/taskplan-deploy.log
lock_file=/run/lock/taskplan-maintenance.lock

log() { printf '%s %s\n' "$(date --utc +%FT%TZ)" "$*" | tee -a "$log_file"; }
die() { log "ERROR: $*"; exit 1; }
[[ $# -eq 2 ]] || die 'Usage: taskplan-deploy VERSION SHA'
version=$1
sha=$2
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'Invalid SemVer version.'
[[ $sha =~ ^[0-9a-f]{40}$ ]] || die 'SHA must be a full lowercase hexadecimal commit SHA.'
[[ -f $env_file && -f $compose && -d $repo ]] || die 'Production layout is incomplete.'
install -d -m 0750 "$state_dir" "$(dirname "$log_file")" "$(dirname "$lock_file")"
exec 9>"$lock_file"
flock -n 9 || die 'Another TaskPlan maintenance operation is running.'

compose_cmd=(docker compose --env-file "$env_file" --env-file "$release_env" -f "$compose")
wait_http() {
  local url=$1 label=$2
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error --max-time 5 "$url" >/dev/null; then
      log "$label is healthy."
      return 0
    fi
    sleep 2
  done
  return 1
}

previous_version=''
if [[ -f $state_file ]]; then
  previous_version="$(sed -n 's/^version=//p' "$state_file" | head -n1)"
fi
promoted=false
rollback() {
  local failed_status=$?
  if [[ $promoted != true || -z $previous_version ]]; then
    exit "$failed_status"
  fi
  log "Deployment failed; attempting application rollback to $previous_version. Database migrations are forward-only and are not reverted."
  local rollback_tmp
  rollback_tmp="$(mktemp "$state_dir/release.env.rollback.XXXXXX")"
  printf 'TASKPLAN_RELEASE=%s\n' "$previous_version" > "$rollback_tmp"
  chmod 0600 "$rollback_tmp"
  mv -f "$rollback_tmp" "$release_env"
  "${compose_cmd[@]}" up -d --no-deps --force-recreate backend || true
  wait_http 'http://192.168.100.15:5183/api/health' 'Rollback API' || true
  "${compose_cmd[@]}" up -d --no-deps --force-recreate frontend || true
  wait_http 'http://192.168.100.15:5182/healthz' 'Rollback frontend' || true
  log "Rollback attempt completed."
  exit "$failed_status"
}
trap rollback ERR

log "Validating release $version ($sha)."
git -C "$repo" fetch --quiet origin main --tags
git -C "$repo" diff --quiet && git -C "$repo" diff --cached --quiet || die 'Controlled clone is not clean.'
tag="v$version"
git -C "$repo" show-ref --verify --quiet "refs/tags/$tag" || die "Tag $tag does not exist."
[[ "$(git -C "$repo" rev-list -n1 "$tag")" == "$sha" ]] || die 'Tag does not resolve to supplied SHA.'
git -C "$repo" merge-base --is-ancestor "$sha" origin/main || die 'Release commit is not an ancestor of origin/main.'
git -C "$repo" checkout --quiet --detach "$sha"

tmp_release="$(mktemp "$state_dir/release.env.next.XXXXXX")"
printf 'TASKPLAN_RELEASE=%s\n' "$version" > "$tmp_release"
chmod 0600 "$tmp_release"
next_compose=(docker compose --env-file "$env_file" --env-file "$tmp_release" -f "$compose")
log 'Building versioned frontend and backend images.'
"${next_compose[@]}" build backend frontend
log 'Applying Prisma migrations before promotion.'
"${next_compose[@]}" run --rm backend npx prisma migrate deploy
mv -f "$tmp_release" "$release_env"
promoted=true
log 'Promoting backend image.'
"${compose_cmd[@]}" up -d --no-deps --force-recreate backend
wait_http 'http://192.168.100.15:5183/api/health' 'API' || die 'API healthcheck failed.'
log 'Promoting frontend image.'
"${compose_cmd[@]}" up -d --no-deps --force-recreate frontend
wait_http 'http://192.168.100.15:5182/healthz' 'Frontend' || die 'Frontend healthcheck failed.'
state_tmp="$(mktemp "$state_dir/current-release.XXXXXX")"
printf 'version=%s\nsha=%s\nimage_backend=taskplan-backend:%s\nimage_frontend=taskplan-frontend:%s\ndeployed_at_utc=%s\n' "$version" "$sha" "$version" "$version" "$(date --utc +%FT%TZ)" > "$state_tmp"
chmod 0640 "$state_tmp"
mv -f "$state_tmp" "$state_file"
log "Deployment succeeded: TaskPlan $version ($sha)."